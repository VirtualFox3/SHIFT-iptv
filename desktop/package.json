{
  "name": "shift-desktop",
  "version": "1.0.0",
  "description": "SHIFT IPTV desktop app (Electron + mpv) — plays MKV/HEVC natively",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "get-mpv": "powershell -ExecutionPolicy Bypass -File scripts/get-mpv.ps1",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.shift.iptv",
    "productName": "SHIFT",
    "files": ["main.js", "preload.js"],
    "extraResources": [
      { "from": "bin", "to": "bin", "filter": ["**/*"] }
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": ["msi", "nsis"],
      "icon": "build/icon.ico",
      "artifactName": "SHIFT-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "msi": {
      "oneClick": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SHIFT",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
